{
  "name": "clientbrief-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write \"{pages,components,hooks,lib,tests,scripts,styles,public}/**/*.{ts,tsx,js,mjs,css,json}\" *.json *.ts eslint.config.mjs",
    "lint": "eslint pages components hooks lib tests scripts public next.config.ts",
    "dev": "next dev",
    "build": "next build && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/smoke-test.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  }
}
