{
  "manifest_version": 3,
  "name": "ClientBrief AI",
  "version": "0.1.0",
  "description": "Turn selected client conversations into evidence-linked project briefs. Local-first preview.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "optional_permissions": [
    "notifications",
    "alarms"
  ],
  "action": {
    "default_title": "Open ClientBrief",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
